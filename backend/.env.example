PROJECT_NAME=Suvai API
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Must be a JSON list
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Replace the placeholder password in your real .env (never commit it)
DATABASE_URL=postgresql+psycopg://suvai_user:change_me@localhost:5432/suvai_db
SECRET_KEY=change-mepython -m pytest -q

# AI assistant (server-side only; the real key goes in your ignored .env)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600
AI_MAX_QUESTION_CHARS=500
