PROJECT_NAME=Suvai API
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Must be a JSON list
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Replace the placeholder password in your real .env (never commit it)
DATABASE_URL=postgresql+psycopg://suvai_user:change_me@localhost:5432/suvai_db
SECRET_KEY=change-me